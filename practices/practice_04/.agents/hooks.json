{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/safety-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "type-checker": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/type-verifier.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "arena-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/reminder.mjs"
      }
    ]
  }
}

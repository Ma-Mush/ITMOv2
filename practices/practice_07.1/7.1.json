    {
      "parameters": {
        "jsCode": "// Получаем сырой diff от предыдущей ноды\nconst rawDiff = $('Get file\\'s PR info').first().json.data || ''; \n\n// 1. Разбиваем diff по файлам\nconst files = rawDiff.split(/(?=diff --git )/);\nconst hunks = []; \n\nfor (const fileDiff of files) { \n  if (!fileDiff.trim()) continue;\n  \n  // Извлекаем относительный путь к файлу (например, app.py)\n  const fileMatch = fileDiff.match(/diff --git a\\/.*? b\\/(.*)/);\n  if (!fileMatch) continue; \n  const filePath = fileMatch[1].split('\\n')[0].trim();\n\n  // 2. Разбиваем файл на отдельные блоки изменений (hunks, начинающиеся с @@)\n  const hunkParts = fileDiff.split(/(?=@@ -\\d+(?:,\\d+)? \\+\\d+(?:,\\d+)? @@)/);\n  \n  for (let i = 1; i < hunkParts.length; i++) {\n    const h = hunkParts[i];\n    // Регулярка для заголовка блока: @@ -старая_строка,длина +новая_строка,длина @@\n    const m = h.match(/@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (!m) continue; \n    \n    const startLine = parseInt(m[1], 10);\n    const lines = h.split('\\n');\n    let targetLine = startLine;\n    let currNewLine = startLine;\n    \n    // 3. Находим первую измененную строку (+), к которой привяжем комментарий \n    for (let j = 1; j < lines.length; j++) {\n      const line = lines[j]; \n      if (line.startsWith('+') && !line.startsWith('+++')) { \n        targetLine = currNewLine; \n        break;\n      } else if (!line.startsWith('-')) {\n        currNewLine++;\n      }\n    }\n    \n    // Формируем отдельный элемент для каждого блока\n    hunks.push({ \n      json: { \n        path: filePath, \n        line: targetLine,\n        hunk: h.trim()\n      },\n      pairedItem: { item: 0 } \n    });\n  }\n}\n\nreturn hunks;\n"
      },
      "type": "n8n-nodes-base.code",

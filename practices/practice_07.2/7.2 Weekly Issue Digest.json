    {
      "parameters": {
        "jsCode": "\nconst current = $('Group Stats').first().json.current; \nconst authors = $('Group Stats').first().json.authors;\nconst week = $('Group Stats').first().json.week;\n\n// Достаем прошлую неделю из Data Table (если записей еще нет, берем нули)                                                                             \nconst prevRow = $json || {};                                                                                                                           \nconst prev = {                                                                                                                                         \n  bugs: Number(prevRow.bugs) || 0,                                                                                                                     \n  features: Number(prevRow.features) || 0,\n  tasks: Number(prevRow.tasks) || 0,\n  needs_triage: Number(prevRow.needs_triage) || 0,\n};\nprev.total = prev.bugs + prev.features + prev.tasks + prev.needs_triage;\n\n// Форматируем дельту со стрелочками/знаками                                                                                                           \nconst formatDelta = (curr, prev) => {                                                                                                                  \n  const diff = curr - prev;\n  if (diff > 0) return `(+${diff})`;\n  if (diff < 0) return `(${diff})`;\n  return `(=0)`;\n};\n\nconst delta = {\n  bugs: formatDelta(current.bugs, prev.bugs),\n  features: formatDelta(current.features, prev.features),\n  tasks: formatDelta(current.tasks, prev.tasks),\n  needs_triage: formatDelta(current.needs_triage, prev.needs_triage),\n  total: formatDelta(current.total, prev.total),\n};\n\nreturn [{\n  json: {\n    week,\n    current,\n    prev,\n    delta,\n    authors\n  }\n}];\n"
      },

    {
      "parameters": {
        "jsCode": "\n// 1. Достаем результаты 4 запросов                                                                                                                    \nconst bugs = $('Request Bug').first().json || { total_count: 0, items: [] };                                                                           \nconst features = $('Request Features').first().json || { total_count: 0, items: [] };\nconst tasks = $('Request Tasks').first().json || { total_count: 0, items: [] };\nconst needsTriage = $('Request Needs-Triage').first().json || { total_count: 0, items: [] };\n\n// 2. Считаем количество по типам\nconst counts = {\n  bugs: bugs.total_count || 0,\n  features: features.total_count || 0,\n  tasks: tasks.total_count || 0,\n  needs_triage: needsTriage.total_count || 0,\n};\ncounts.total = counts.bugs + counts.features + counts.tasks + counts.needs_triage;\n\n// 3. Группируем по авторам (кто сколько создал)                                                                                                       \nconst authorMap = {};\nconst allItems = [\n  ...(bugs.items || []),\n  ...(features.items || []),\n  ...(tasks.items || []),\n  ...(needsTriage.items || [])\n];\n\nfor (const item of allItems) {\n  const author = item.user ? item.user.login : 'unknown';\n  authorMap[author] = (authorMap[author] || 0) + 1;\n}\n\nconst authorsList = Object.entries(authorMap).map(([author, count]) => ({\n  author,\n  count\n})).sort((a, b) => b.count - a.count);\n\nconst weekLabel = $now.toFormat(\"yyyy-'W'WW\");\n\nreturn [{\n  json: {\n    week: weekLabel,\n    current: counts,\n    authors: authorsList\n  }\n}];\n"
      },

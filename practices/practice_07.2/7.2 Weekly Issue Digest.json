        "subject": "=📊 Еженедельный дайджест GitHub Issues (Неделя {{$('Calculate Delta').first().json.week }})",
        "html": "=<h2>📊 Еженедельный отчет по GitHub Issues (Неделя {{ $('Calculate Delta').first().json.week }})</h2>                                                 \n                                                                                                                                                       \n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; max-width: 500px; font-family: sans-serif;\">          \n  <tr style=\"background-color: #f2f2f2;\">                                                                                                              \n    <th>Категория</th>                                                                                                                                 \n    <th>Количество</th>                                                                                                                                \n    <th>Динамика (Δ)</th>                                                                                                                              \n  </tr>                                                                                                                                                \n  <tr>                                                                                                                                                 \n    <td>🐛 Баги (bug)</td>                                                                                                                             \n    <td><b>{{ $('Calculate Delta').first().json.current.bugs }}</b></td>                                                                               \n    <td>{{ $('Calculate Delta').first().json.delta.bugs }}</td>                                                                                        \n  </tr>                                                                                                                                                \n  <tr>                                                                                                                                                 \n    <td>✨ Новые фичи (feature)</td>                                                                                                                   \n    <td><b>{{ $('Calculate Delta').first().json.current.features }}</b></td>\n    <td>{{ $('Calculate Delta').first().json.delta.features }}</td>                                                                                    \n  </tr>                                                                                                                                                \n  <tr>\n    <td>📋 Задачи (task)</td>                                                                                                                          \n    <td><b>{{ $('Calculate Delta').first().json.current.tasks }}</b></td>\n    <td>{{ $('Calculate Delta').first().json.delta.tasks }}</td>\n  </tr>\n  <tr>\n    <td>🔍 На триаже (needs-triage)</td>                                                                                                               \n    <td><b>{{ $('Calculate Delta').first().json.current.needs_triage }}</b></td>\n    <td>{{ $('Calculate Delta').first().json.delta.needs_triage }}</td>\n  </tr>\n  <tr style=\"background-color: #fafafa;\">\n    <td><b>Всего</b></td>\n    <td><b>{{ $('Calculate Delta').first().json.current.total }}</b></td>\n    <td><b>{{ $('Calculate Delta').first().json.delta.total }}</b></td>\n  </tr>\n</table>\n\n<h3>👥 Топ авторов недели:</h3>                                                                                                                        \n<ul>\n  {{ $('Calculate Delta').first().json.authors.map(a => `<li><b>${a.author}</b>: ${a.count} issue</li>`).join('') || '<li>Нет активности</li>' }}      \n</ul>\n\n<div style=\"background-color: #eef7ff; border-left: 4px solid #0066cc; padding: 12px; margin-top: 16px; font-family: sans-serif;\">\n  <h4 style=\"margin: 0 0 8px 0; color: #0066cc;\">🤖 AI-комментарий недели:</h4>                                                                        \n  <p style=\"margin: 0;\">{{ $('Basic LLM Chain').first().json.text || $('Basic LLM Chain').first().json.output }}</p>\n</div>\n",

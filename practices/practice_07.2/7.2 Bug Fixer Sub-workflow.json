        "jsCode": "const mainData = $('Get Main SHA').first().json || {};\nconst mainSha = mainData.object ? mainData.object.sha : '';\n\nconst context = $('Prepare Bug Context').first().json;\nconst llmText = $('AI Fix Bug1').first().json.text || '';\n\n// Очистка от ```python и ``` если нейросеть добавила markdown-блоки\nlet cleanCode = llmText.trim();\nif (cleanCode.startsWith('```python')) {\n  cleanCode = cleanCode.replace(/^```python\\s*/, '').replace(/\\s*```$/, '');\n} else if (cleanCode.startsWith('```')) {\n  cleanCode = cleanCode.replace(/^```\\s*/, '').replace(/\\s*```$/, '');\n}\n\nconst contentBase64 = globalThis.Buffer.from(cleanCode, 'utf-8').toString('base64');\nconst branchName = `fix/issue-${context.issue_number}`;\n\nreturn [{\n  json: {\n    branch_name: branchName,\n    main_sha: mainSha,\n    file_path: context.file_path,\n    file_sha: context.file_sha,\n    content_base64: contentBase64,\n    clean_code: cleanCode,\n    original_code: context.original_code,\n    issue_number: context.issue_number,\n    title: context.title\n  }\n}];"
